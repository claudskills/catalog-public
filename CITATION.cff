cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
title: "ClaudSkills Open Catalog of Claude Code Skills"
abstract: >
  Machine-readable catalog of 154,290+ Claude Code / Claude
  Skills SKILL.md files, mined daily from public sources including
  GitHub, GitLab, Codeberg, HuggingFace, awesome-lists, and social
  platforms. Mirrors the live catalog at claudskills.com. Each row
  carries author + source + license attribution where the upstream
  source disclosed it.
type: dataset
authors:
  - name: ClaudSkills
    website: "https://claudskills.com"
    affiliation: ACreatorStore
license: CC-BY-4.0
url: "https://github.com/claudskills/catalog-public"
repository: "https://github.com/claudskills/catalog-public"
date-released: 2026-07-20
version: "2026.07.20"
keywords:
  - claude
  - claude-code
  - claude-skills
  - llm
  - ai-agents
  - developer-tools
  - skill-md
